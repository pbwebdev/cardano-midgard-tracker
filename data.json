    },
    {
      "sha": "16ddcbe43bb5a55e5fd742083739b64c44492f51",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/16ddcbe43bb5a55e5fd742083739b64c44492f51",
      "message": "feat: add aiken fmt to prefix generator script",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-03T16:40:20Z"
    },
    {
      "sha": "1ddab7448736bd25c299ccc9d1f875fa9f28e0dd",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/1ddab7448736bd25c299ccc9d1f875fa9f28e0dd",
      "message": "feat: add script for generating witness prefix\n\nMoved the witness script prefix from its library module to `env`\nmodules, and added a script that builds Aiken blueprint for both\nenvironments (`default` and `testnet`), extracts the final prefixes, and\ninjects them into their respective `.ak` files.\n\nAlso added a diff check to the CI for the `main` branch.",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-03T16:24:29Z"
    },
    {
      "sha": "1143021e1f725db5ca95596b9c7f5ada52119110",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/1143021e1f725db5ca95596b9c7f5ada52119110",
      "message": "refactor(aiken): move constants to env",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-03T13:44:34Z"
    },
    {
      "sha": "9ce2b7be0c42169f8e22fe305992c4a066e5fb05",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/9ce2b7be0c42169f8e22fe305992c4a066e5fb05",
      "message": "fix(aiken): remove re-registration path\n\nSince removal of bad state queue blocks required non-membership proof\nfor operators that had already been slashed, carrying bond unlock times\nin regsitered nodes was not practical (registered set is ordered by\nactivation times rather than public key hashes).\n\nThis path also didn't seem very necessary compared to the level\ncomplexity it had introduced.\n\nThe downside of this removal is that operators retired due to inactivity\ncaused by technical issues rather that negligence will have to wait\nlonger to get back into the queue.",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-01T21:35:47Z"
    },
    {
      "sha": "253d51f72d694f4d83e0d5eb85e305fa462a9c89",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/253d51f72d694f4d83e0d5eb85e305fa462a9c89",
      "message": "feat(aiken): prepare lib modules for fixing slash\n\nState queue and settlement contracts only considered slashing of active\nor retired operators. However, now that registered operators can also be\nslashed for bad state / resolution claim, they need to allow for that as\nwell.",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-01T16:40:16Z"
    },
    {
      "sha": "d54031e4d6bb794d99600629b2011605009e6695",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/d54031e4d6bb794d99600629b2011605009e6695",
      "message": "fix(docs): align with aiken code",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-01T16:36:19Z"
    },
    {
      "sha": "3a43af8bc0c2614953cd046d85c6443b302fba67",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/3a43af8bc0c2614953cd046d85c6443b302fba67",
      "message": "fix(docs): syntax and incorrect restraint in sched",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-05-01T15:11:49Z"
    },
    {
      "sha": "55fe98f1ec3150f09a3b87b47a9488d8bbaba3f0",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/55fe98f1ec3150f09a3b87b47a9488d8bbaba3f0",
      "message": "fix(aiken): prevent shortening of bond unlock time\n\nSince new bond unlock times are computed based on the validity range's\nupper bound, it was possible for an operator to pull back their bond\nunlock time by first committing a fraud with a transaction that had\nvalidity range with an upper bound far in the future, and follow it with\nan honest commitment that's closest possible to present.\n\nThis commit ensures bond unlock times are monotonically increasing.",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-04-26T22:49:42Z"
    },
    {
      "sha": "d29eafd68c0acf571713ae90ffe904fba6519705",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/d29eafd68c0acf571713ae90ffe904fba6519705",
      "message": "fix(aiken): preserve anchor's ada on op. reg.\n\nWith removal of the requirement for new registered operators getting\nprepended to the list, it now becomes crucial to ensure the anchor\nelement's ADA is preserved, since it now is not necessarily the root\nelement.",
      "authorName": "keyanmaskoot",
      "authorDate": "2026-04-26T17:46:36Z"
    }
  ],
