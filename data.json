  "commits": [
    {
      "sha": "4e5135b39fc5d09e18e91743fc8f6bb5171d6bd5",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/4e5135b39fc5d09e18e91743fc8f6bb5171d6bd5",
      "message": "Pin Go 1.26.5 and provide Cargo in the demo Nix shell\n\nThe native L1 transport requires Go 1.26.5, while the MPF owner needs\nCargo and a Rust compiler. The demo shell selected Go 1.25.7 and omitted\nthe Rust tools, leaving native builds and devnet prerequisite checks\ndependent on tools installed outside the shell.\n\nUpdate the Go package, lockfile and version checks to 1.26.5. Use the\nnixpkgs 26.05 backport to retain Intel macOS support. Include Cargo and\nrustc 1.94.1 from the existing pinned toolchain input and print their\nversions when entering the shell.\n\nValidation (2026-10-15, repository root):\n`nix flake check --no-build --all-systems --no-write-lock-file ./demo`\nevaluated all four supported platform shells successfully, exit 0.\n`git diff --check` completed with exit 0.\n\nValidation was limited to evaluation; no packages were built and no\ndevnet was started.",
      "authorName": "keyanm",
      "authorDate": "2026-10-15T16:15:40Z"
    },
    {
      "sha": "7b1accfabf6e25794194bc4ddb3b2a2c4bd2041d",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/7b1accfabf6e25794194bc4ddb3b2a2c4bd2041d",
      "message": "Clarify the nixpkgs release choice for the Go toolchain\n\nName nixpkgs explicitly and explain why the Go pin uses its 26.05 release: nixpkgs 26.11 dropped Intel Mac support.",
      "authorName": "keyanm",
      "authorDate": "2026-10-15T12:24:42Z"
    },
    {
      "sha": "5ac344ab486ac776bd728aa771c78efe0caea8f7",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/5ac344ab486ac776bd728aa771c78efe0caea8f7",
      "message": "Align the demo Nix shell with Go 1.26.5\n\nMatch the native L1 transport's Go 1.26.5 requirement by updating the\nGo package, nixpkgs revision, lockfile and version checks.\n\nUse the 26.05 backport to retain Intel macOS support while keeping the\nNode, pnpm and other flake inputs unchanged.\n\nValidation (2026-10-15, repository root):\n`nix flake check --no-build --all-systems --no-write-lock-file ./demo`\ncompleted with exit 0 for all four platforms. Evaluation only; no\npackages were built.",
      "authorName": "keyanm",
      "authorDate": "2026-10-15T10:19:59Z"
    },
    {
      "sha": "740b2f9086c7b4be5b46bc1edc1e749315e42975",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/740b2f9086c7b4be5b46bc1edc1e749315e42975",
      "message": "Support ARM64 Docker stacks and document build heap limits\n\nReplace AMD64-only image pins with immutable image lists for ARM64 and\nAMD64, keeping private-testnet helpers and Preprod defaults aligned.\nPostgreSQL stays on 15.15 with refreshed image builds.\n\nDocument an optional 8 GiB heap override for Node build failures,\npreserving existing options and explaining RAM use.",
      "authorName": "keyanm",
      "authorDate": "2026-10-14T22:25:51Z"
    },
    {
      "sha": "d8598fe98093e9353f2c2102b476a99cc084ab1e",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/d8598fe98093e9353f2c2102b476a99cc084ab1e",
      "message": "Give the maximum-shape Data step planner cases an explicit timeout",
      "authorName": "Philip DiSarro",
      "authorDate": "2026-10-14T04:33:25Z"
    },
    {
      "sha": "d976e5d3fbd518e760f3327a47c8a36559a62cdc",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/d976e5d3fbd518e760f3327a47c8a36559a62cdc",
      "message": "Merge CI-reds lane: lint, ledgers, DA fixture, compose and fault-proof shard fixes",
      "authorName": "Philip DiSarro",
      "authorDate": "2026-10-14T04:32:38Z"
    },
    {
      "sha": "9f56d2e21969ba8f034a1b7bc41d331f3302facd",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/9f56d2e21969ba8f034a1b7bc41d331f3302facd",
      "message": "Drop the validation-dispute argument case whose flags left the CLI",
      "authorName": "Philip DiSarro",
