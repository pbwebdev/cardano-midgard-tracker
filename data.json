    {
      "sha": "1fdadc0db7691de43dd57b49493a37fe496cd616",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/1fdadc0db7691de43dd57b49493a37fe496cd616",
      "message": "Regenerate the event-history admission and transition-trace workflow fit ledgers on the current blueprint",
