      "authorDate": "2026-10-26T11:05:57Z"
    },
    {
      "sha": "b3c16599915ed136e36b54d15a91abedd4d1ae17",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/b3c16599915ed136e36b54d15a91abedd4d1ae17",
      "message": "List the all-purposes scan steps the script-integrity and missing-redeemer walks share",
      "authorName": "Philip DiSarro",
      "authorDate": "2026-10-26T10:49:46Z"
    },
    {
      "sha": "f1239d33ce3f837cd905b9f884df95d580d2a156",
      "html_url": "https://github.com/Anastasia-Labs/midgard/commit/f1239d33ce3f837cd905b9f884df95d580d2a156",
      "message": "Leave a leaf with an unresolved input to the input families in script-integrity detection\n\nDetection now declines when a spent or referenced input has no\npredecessor descriptor instead of failing to build the source index, so\nthe replay goes on to prove the missing input.",
      "authorName": "Philip DiSarro",
      "authorDate": "2026-10-26T10:49:40Z"
    },
